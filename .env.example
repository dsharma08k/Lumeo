# Backend Configuration
DEVICE=cpu
# Options: cpu, cuda

# Supabase (Optional - for feedback/sharing features)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Security
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting (requests per time period)
RATE_LIMIT_ENHANCE=10/minute
RATE_LIMIT_ANALYZE=30/minute

# File Upload Limits
MAX_FILE_SIZE_MB=10
MAX_IMAGE_DIMENSION=4096

# Inference Quality (no retraining needed)
# Preserve aspect ratio and downscale only if larger than this side length
MAX_INFER_SIZE=512

# Highlight recovery in post-processing
# Higher blend recovers detail in bright regions by mixing model output with input
HIGHLIGHT_BLEND_STRENGTH=0.65
HIGHLIGHT_START=0.82
HIGHLIGHT_END=0.98

# Apply model output mostly in shadows to avoid gray/washed bright areas
SHADOW_BLEND_STRENGTH=0.78
SHADOW_START=0.05
SHADOW_END=0.45

# Hybrid fallback: blend model output with classical gamma shadow-lift
CLASSIC_SHADOW_GAMMA=0.72
CLASSIC_BLEND=0.55

# Output tone control (>1 darkens a little to reduce washed highlights)
OUTPUT_GAMMA=1.05

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR
